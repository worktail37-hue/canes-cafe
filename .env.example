# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# CANE'S SERVE - OWNER WHATSAPP ALERT NOTIFICATIONS
# ==============================================================================
# When a customer submits an enquiry on the website, an instant WhatsApp message
# is sent to the owner containing customer name, mobile number, email, and message.
# Privacy rule: These credentials and phone numbers are strictly server-side.

# Owner WhatsApp Phone Number (International E.164 format, e.g., +14155552671)
ADMIN_WHATSAPP_PHONE="+14155552671"

# OPTION A: Meta WhatsApp Business Cloud API (Recommended official API)
# Get from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# OPTION B: Twilio Programmable Messaging (Alternative WhatsApp API)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# OPTION C: Custom WhatsApp / Automation Webhook (Make / Zapier / n8n / Botpress)
# If provided, the server dispatches a structured JSON payload on every enquiry.
WHATSAPP_WEBHOOK_URL="https://hook.us1.make.com/..."

